                    Update QR
                </button>
                <button onclick="downloadQr()" class="flex-1 py-2.5 bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg transition flex items-center justify-center gap-1.5">
                    <i class="fa-solid fa-download"></i> Download
