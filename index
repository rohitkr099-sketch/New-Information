            </p>

            <div class="space-y-2">
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Target Web URL</label>
                <input type="url" id="qrUrlInput" value="https://yourusername.github.io/profile/" 
                       class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-900 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-brand-500 outline-none font-mono">
            </div>

            <!-- QR Code Box -->
